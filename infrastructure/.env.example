# Copy to .env and change before running docker compose.
POSTGRES_PASSWORD=change-me-to-a-long-random-string
# The URL people open in the browser (used for CORS on the API)
PUBLIC_URL=http://localhost:8081
# Set to true when serving over HTTPS
COOKIE_SECURE=false
# Optional: enables YouTube search inside Safari (YouTube Data API v3 key)
YOUTUBE_API_KEY=
