# Optional build-time settings for the frontend (copy to .env.local)
# Backend URL for accounts + preference sync, or "same-origin" behind a reverse proxy
VITE_API_URL=
# YouTube Data API v3 key, enables YouTube search inside Safari
VITE_YOUTUBE_API_KEY=
# Google Maps key (Maps JavaScript, Places (New), Routes and Geocoding APIs) for the Maps app
VITE_GOOGLE_MAPS_API_KEY=
